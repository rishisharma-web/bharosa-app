# Copy this file to .env and fill it in locally:  copy .env.example .env  (macOS/Linux: cp)
# .env is git-ignored. Never put real keys in this file: it is committed.

DEMO_DATE=2026-10-31
# Your current tunnel address when using phones (https://....trycloudflare.com)
PUBLIC_BASE_URL=http://localhost:8000
DEMO_OTP=123456
# Presenter key for Reset and login QRs: change it
ADMIN_KEY=change-me
DB_PATH=bharosa.db

SARVAM_ENABLED=false
# Your Sarvam key goes in .env only
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TIMEOUT_S=8
# none = fastest; the model's "thinking" otherwise pushes calls past the timeout
SARVAM_REASONING_EFFORT=none
